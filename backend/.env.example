FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Set USE_SQLITE=true for local dev without MySQL
USE_SQLITE=true

# MySQL (used when USE_SQLITE is false)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=legalmetro

# Mail (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# App URLs
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Upload folder (relative to backend/)
UPLOAD_FOLDER=uploads
